# ==========================================
# NEXUS SMART HOME CONFIGURATION
# ==========================================

# Home Assistant Connection
HA_URL=http://localhost:8123
HA_TOKEN=your_long_lived_access_token_here

# 2. LLM Engine Provider ('ollama' or 'gemini')
LLM_PROVIDER=ollama

# Google Gemini API (Cloud)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local LLM via Ollama (100% Offline, Recommended: qwen2.5:1.5b or qwen2.5:3b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Wake Word & VAD Settings
WAKE_WORD_MODEL=hey_nexus
WAKE_WORD_THRESHOLD=0.5
SILENCE_DURATION_SEC=1.2
SAMPLE_RATE=16000

# STT (Faster-Whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=vi

# TTS (Microsoft Edge-TTS)
TTS_VOICE=vi-VN-NamMinhNeural
TTS_RATE=+5%
TTS_PITCH=+0Hz

# 6. MÁY CHỦ WEB DASHBOARD & LIVE HUD
HOST=0.0.0.0
PORT=8080
DEBUG=False

# 7. CẤU HÌNH VỆ TINH MICRO (SATELLITE TRÊN LINUX)
# Địa chỉ IP của máy Windows Master để vệ tinh Linux kết nối tới
SATELLITE_SERVER_URL=ws://192.168.1.100:8080/ws/satellite
SATELLITE_NAME=Linux Server Mic
