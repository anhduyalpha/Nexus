# Defaults bind only to loopback. No credentials are needed for local preview.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=4310
# Set a long private token before binding to a non-loopback address.
# NEXUS_TOKEN=
# NEXUS_ORIGIN=https://nexus.example.com
# NEXUS_DATA_DIR=C:/NexusData
# NEXUS_REDIS_URL=redis://127.0.0.1:6379
