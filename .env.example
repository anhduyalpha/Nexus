# Defaults are safe for a local preview. Never commit your .env file.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=4310
# Run pnpm services (Docker Desktop required) to start Redis.
NEXUS_REDIS_URL=redis://127.0.0.1:6379
# Set a long private token before non-loopback binding / full Docker mode.
# NEXUS_TOKEN=
# NEXUS_ORIGIN=https://nexus.example.com
# NEXUS_DATA_DIR=C:/NexusData
